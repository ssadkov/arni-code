{
    "name": "vk-authentication",
    "displayName": "VK Authentication",
    "description": "VK ID authentication provider for Arni Code",
    "publisher": "arnion",
    "version": "1.0.0",
    "license": "MIT",
    "engines": {
        "vscode": "*"
    },
    "categories": [
        "Other"
    ],
    "main": "./dist/extension.js",
    "activationEvents": [
        "onAuthenticationRequest:vk",
        "onCommand:vk.signIn",
        "onCommand:vk.signOut"
    ],
    "contributes": {
        "authentication": [
            {
                "id": "vk",
                "label": "VK ID"
            }
        ],
        "commands": [
            {
                "command": "vk.signIn",
                "title": "Arni: Sign In with VK ID"
            },
            {
                "command": "vk.signOut",
                "title": "Arni: Sign Out from VK ID"
            }
        ],
        "configuration": {
            "title": "VK Authentication",
            "properties": {
                "vk.clientId": {
                    "type": "string",
                    "default": "54785916",
                    "description": "VK ID app id baked into the build. The VK ID cabinet base domain is localhost and the trusted redirect URL is https://localhost."
                },
                "vk.redirectPort": {
                    "type": "number",
                    "default": 443,
                    "description": "Loopback port. The VK ID local redirect is https://localhost, which uses port 443."
                }
            }
        }
    },
    "scripts": {
        "build": "node esbuild.js",
        "compile": "tsc -p ./"
    },
    "devDependencies": {
        "@types/node": "^20.x",
        "@types/vscode": "^1.93.0",
        "esbuild": "^0.20.0",
        "typescript": "^5.x"
    }
}
